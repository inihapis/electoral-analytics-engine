generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  bpds      Bpd[]    @relation("UpdatedBy")
}

model Candidate {
  id          String               @id @default(uuid())
  name        String               @unique
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  affiliation String?
  supportedBpds Bpd[]              @relation("SupportedBpd")
}

model Bpd {
  id                   String               @id @default(uuid())
  provinceName         String               @unique
  totalVotes           Int                  @default(5)
  targetMc             String?
  politicalAffiliation String?
  supportStatus        SupportStatus
  characteristic       Characteristic
  updatedById          String
  updatedAt            DateTime             @updatedAt
  afiliasiPolitik      Boolean              @default(false)
  atributFisik         Boolean              @default(false)
  kedekatanMc          Boolean              @default(false)
  sosialMedia          Boolean              @default(false)
  suratBaiat           Boolean              @default(false)
  videoDukungan        Boolean              @default(false)
  updatedBy            User                 @relation("UpdatedBy", fields: [updatedById], references: [id])
  supportedCandidateId String?
  supportedCandidate   Candidate?           @relation("SupportedBpd", fields: [supportedCandidateId], references: [id])
}

enum Role {
  SUPERADMIN
  ADMIN
  USER
}

enum SupportStatus {
  TERKUNCI
  MENGARAH
  DINAMIS
}

enum Characteristic {
  SOLID
  RENTAN
  WASPADA
}


