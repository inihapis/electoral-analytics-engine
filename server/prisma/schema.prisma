generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  bpds      Bpd[]    @relation("UpdatedBy")
}

model Candidate {
  id          String               @id @default(uuid())
  name        String               @unique
  color       CandidateColor
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  affiliation String?
  indicators  CandidateIndicator[]
  supportedBpds Bpd[]              @relation("SupportedBpd")
}

model Bpd {
  id                   String               @id @default(uuid())
  provinceName         String               @unique
  totalVotes           Int                  @default(5)
  targetMc             String?
  politicalAffiliation String?
  supportStatus        SupportStatus
  characteristic       Characteristic
  updatedById          String
  updatedAt            DateTime             @updatedAt
  afiliasiPolitik      Boolean              @default(false)
  atributFisik         Boolean              @default(false)
  kedekatanMc          Boolean              @default(false)
  sosialMedia          Boolean              @default(false)
  suratBaiat           Boolean              @default(false)
  videoDukungan        Boolean              @default(false)
  updatedBy            User                 @relation("UpdatedBy", fields: [updatedById], references: [id])
  supportedCandidateId String?
  supportedCandidate   Candidate?           @relation("SupportedBpd", fields: [supportedCandidateId], references: [id])
  indicators           CandidateIndicator[]
}

model CandidateIndicator {
  id              String    @id @default(uuid())
  bpdId           String
  candidateId     String
  suratBaiat      Boolean   @default(false)
  afiliasiPolitik Boolean   @default(false)
  videoDukungan   Boolean   @default(false)
  kedekatanMc     Boolean   @default(false)
  atributFisik    Boolean   @default(false)
  sosialMedia     Boolean   @default(false)
  totalPoints     Float     @default(0)
  score           Float     @default(0)
  estimatedVotes  Float     @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  bpd             Bpd       @relation(fields: [bpdId], references: [id], onDelete: Cascade)
  candidate       Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([bpdId, candidateId])
}

enum Role {
  SUPERADMIN
  ADMIN
  USER
}

enum SupportStatus {
  TERKUNCI
  MENGARAH
  DINAMIS
}

enum Characteristic {
  SOLID
  RENTAN
  WASPADA
}

enum CandidateColor {
  BLUE
  RED
  YELLOW
  GREEN
}
